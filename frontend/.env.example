# Секрет подписи токенов.
#
# ОБЯЗАН совпадать со значением JWT_SECRET_KEY бэкенда: этим ключом
# бэкенд подписывает токен при входе, а proxy.ts проверяет подпись перед
# тем, как пустить в кабинет. Разные значения дают бесконечный возврат на
# страницу входа при полностью верном токене.
#
# Скопируйте файл в .env.local и подставьте значение из корневого .env.
JWT_SECRET_KEY=

# Адрес движка (assistwidget) — источник личности и прав для портала.
#
# Кабинет ходит туда со стороны сервера: спрашивает, кто вошёл, и что у него
# оплачено. Значение серверное, без префикса NEXT_PUBLIC_ — браузер этого
# адреса не видит и в движок напрямую не ходит.
#
# Локально движок поднимается через `npm run engine` в репозитории
# assistwidget и слушает PORT, по умолчанию 3000.
ENGINE_BASE_URL=http://localhost:3000
