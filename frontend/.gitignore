# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pnpm
.pnpm-debug.log*
# pnpm-lock.yaml is COMMITTED on purpose. 30 of 38 dependencies sit on caret
# ranges, so without the lockfile a fresh clone resolves whatever satisfies
# them that day — a different React, a different Tailwind, a different set of
# advisories than the one that was audited. pnpm-workspace.yaml was already
# tracked despite being listed here, which is how the inconsistency showed.
