DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sales_analyst
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
SOFA_BELLE_TENANT_ID=00000000-0000-0000-0000-000000000001
LOG_LEVEL=INFO

# MEFI CRM (read key — lrd_* prefix; required, application refuses to start without it)
MEFI_API_KEY=lrd_your_key_here

# Docker Compose convenience variables (not used by the application directly)
POSTGRES_PASSWORD=password
POSTGRES_DB=sales_analyst
POSTGRES_USER=user
